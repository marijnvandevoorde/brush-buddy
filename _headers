# Cloudflare Pages response headers.
# Rules are additive: /* applies to every response, and a more specific path
# adds to it.
#
# ⚠️  The Cache-Control rules below are currently INERT for .js/.css.
# The zone's Browser Cache TTL (Caching → Configuration) is set to 4 hours and
# rewrites Cache-Control on anything Cloudflare edge-caches, overriding what
# Pages sends. Measured: files served DYNAMIC (index.html, .webmanifest) keep
# the max-age=0 set here; files that hit the edge cache (.js, .css) come back as
# max-age=14400 regardless. Setting Browser Cache TTL to "Respect Existing
# Headers" makes these rules take effect — until then they are documentation.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# sw.js does not actually need this to update: updateViaCache defaults to
# "imports", so browsers always fetch the main worker script from the network
# on an update check. It is here so the worker is never *installed* from a
# stale copy, and to keep sw.js and the shell it caches on one policy.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# This is the rule that matters. App-shell filenames are unversioned — the CACHE
# rev in sw.js is what invalidates them — and cache.addAll() during install goes
# through the HTTP cache. With a 4h max-age, a rev bump can copy the *old*
# app.js into the *new* service-worker cache and pin it there until the next
# bump. (Fixable in sw.js too, by adding these with cache: "reload".)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/streaks.js
  Cache-Control: public, max-age=0, must-revalidate
/streak-logic.js
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
